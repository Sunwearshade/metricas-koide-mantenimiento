# ============================================================
# Metricos de Mantenimiento - configuracion de produccion
# Copiar a ".env" (install.ps1 lo genera automaticamente).
# Este archivo contiene contrasenas: NO compartirlo.
# ============================================================

# --- Servidor web ---
# Puerto HTTP. Los usuarios abren http://<nombre-o-IP-del-servidor>:<PORT>
PORT=4173
# HOST vacio = escuchar en todas las interfaces (necesario para la LAN)
HOST=

# --- MySQL ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=metricos
DB_USER=metricos
DB_PASSWORD=

# --- Carpetas (relativas a la carpeta de la app o absolutas) ---
DATA_DIR=data
LOG_DIR=logs
BACKUP_DIR=backups
BACKUP_RETENTION_DAYS=30

# --- API koide (tiempo muerto) ---
KOIDE_BASE_URL=http://192.168.1.201:4000
KOIDE_DEPARTMENT=Mantenimiento
KOIDE_PASSWORD=

# --- Python y Excel de requisiciones ---
# Ruta completa a python.exe (el servicio no usa el PATH del usuario)
PYTHON_PATH=C:\Program Files\Python312\python.exe
# IMPORTANTE: usar rutas UNC (\\servidor\recurso\...). El servicio de Windows
# NO ve las unidades mapeadas como Z:.
GASTOS_EXCEL_PATH=\\SERVIDOR\RECURSO\1.REQUISICIONES\6. REQUISICIONES 2026\12.- MANTENIMIENTO\2.-  MANTENIMIENTO_2026.xlsx
ENTREGAS_EXCEL_PATH=\\SERVIDOR\RECURSO\1.REQUISICIONES\6. REQUISICIONES 2026\0. TIEMPOS DE ENTREGA\TIEMPO DE ENTREGA.xlsx
GASTOS_EXCEL_PASSWORD=
