# ============================================================
# Metricos de Mantenimiento - configuracion de produccion
# Copiar a ".env" (install.ps1 lo genera automaticamente).
# Este archivo contiene contrasenas: NO compartirlo.
# ============================================================

# --- Servidor web ---
# Puerto HTTP. Los usuarios abren http://<nombre-o-IP-del-servidor>:<PORT>
PORT=4173
# HOST vacio = escuchar en todas las interfaces (necesario para la LAN)
HOST=

# --- MySQL 8 / MariaDB 10.4+ (XAMPP en desarrollo) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=metricos
DB_USER=metricos
DB_PASSWORD=

# --- Carpetas (relativas a la carpeta de la app o absolutas) ---
DATA_DIR=data
LOG_DIR=logs
BACKUP_DIR=backups
BACKUP_RETENTION_DAYS=30

# --- Sesiones de usuarios ---
# Horas que dura una sesion iniciada.
SESSION_HOURS=12
# 1 = cookie solo por HTTPS (activar si se publica detras de HTTPS).
COOKIE_SECURE=0

# --- KOIDE MES (koide-general): FUENTE OFICIAL de los paros de mantenimiento ---
# URL del backend del MES y token de servicio. El token se emite en el MES con:
#   node scripts/mantenimiento/emitir_token_servicio.js --db=<base> --nombre=metricas-mantenimiento
KOIDE_GENERAL_URL=http://192.168.1.201:3000
KOIDE_GENERAL_TOKEN=
KOIDE_GENERAL_TIMEOUT_MS=20000
# Resincronizacion del dashboard con el MES (segundos; 0 = solo la diaria)
KOIDE_GENERAL_REFRESH_SEC=20

# --- DEPENDENCIA LEGACY TEMPORAL: koide-production-app ---
# Solo para los procesos AUN NO migrados al MES (hoy: corte, CNC, prensa).
# Los procesos migrados (biselado) se ignoran aunque el sistema viejo los
# devuelva. Dejar KOIDE_BASE_URL VACIO = sistema viejo apagado.
KOIDE_BASE_URL=http://192.168.1.201:4000
KOIDE_DEPARTMENT=Mantenimiento
KOIDE_PASSWORD=
KOIDE_TIMEOUT_MS=20000

# (Retirado) TERMINAL_API_KEY: el codigo de cierre ya no se valida aqui; la
# terminal de produccion lo valida directamente en KOIDE MES.

# --- Python y Excel de requisiciones ---
# Ruta completa a python.exe (el servicio no usa el PATH del usuario)
PYTHON_PATH=C:\Program Files\Python312\python.exe
# IMPORTANTE: usar rutas UNC (\\servidor\recurso\...). El servicio de Windows
# NO ve las unidades mapeadas como Z:.
GASTOS_EXCEL_PATH=\\SERVIDOR\RECURSO\1.REQUISICIONES\6. REQUISICIONES 2026\12.- MANTENIMIENTO\2.-  MANTENIMIENTO_2026.xlsx
ENTREGAS_EXCEL_PATH=\\SERVIDOR\RECURSO\1.REQUISICIONES\6. REQUISICIONES 2026\0. TIEMPOS DE ENTREGA\TIEMPO DE ENTREGA.xlsx
GASTOS_EXCEL_PASSWORD=
